# Environment Configuration for RosterGuard
# DO NOT COMMIT THE REAL .env FILE WITH SECRETS

# Database Credentials (REQUIRED: Set a strong unique password in your local .env)
POSTGRES_DB=rosterguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# JDBC URL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rosterguard

# Security & JWT (REQUIRED: Generate a cryptographically secure 256-bit key, e.g. `openssl rand -hex 32`)
# The application will fail to start if JWT_SECRET is missing or less than 32 characters.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Development/Demo Seeding Password (REQUIRED for demo seeding; leave blank to disable demo accounts in production)
ROSTER_DEMO_PASSWORD=

# Nightly Reconciliation Safety Brake (0.30 = 30% missing threshold)
ROSTER_RECONCILIATION_MISSING_THRESHOLD=0.30
ROSTER_RECONCILIATION_BATCH_SIZE=1000

# Outbox Polling Worker
ROSTER_OUTBOX_POLLING_INTERVAL_MS=1000
ROSTER_OUTBOX_BATCH_SIZE=50
ROSTER_OUTBOX_MAX_RETRIES=5
